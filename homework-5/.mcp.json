{
  "mcpServers": {
    "github": {
      "command": "gh",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Development\\_demo"
      ]
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2"
    },
    "local-resources": {
      "type": "stdio",
      "command": "node",
      "args": [
        "local-resources-mcp/index.js"
      ],
      "env": {}
    }
  }
}