{
  "name": "support-ticket-api",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:perf": "start-server-and-test start http://localhost:3000/tickets \"jest --config jest.perf.config.js --verbose\"",
    "test:integr": "start-server-and-test start http://localhost:3000/tickets \"jest --config jest.integr.config.js --verbose\"",
    "test:e2e": "start-server-and-test start http://localhost:3000/tickets \"jest --config jest.e2e.config.js --verbose\""
  },
  "dependencies": {
    "csv-parse": "^5.5.6",
    "express": "^4.18.2",
    "joi": "^17.11.0",
    "uuid": "^9.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "start-server-and-test": "^3.0.5",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "tests/test_performance.test.js",
      "tests/test_integration.test.js",
      "tests/test_e2e.test.js"
    ]
  }
}
